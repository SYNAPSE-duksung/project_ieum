{
  "manifest_version": 3,

  "name": "IEUM Demo",
  "description": "Speech Caption Demo",
  "version": "1.0",

  "permissions": [
    "tabs"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://meet.google.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}